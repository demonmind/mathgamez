# Copy this file to .env and fill in real values before running
# `docker compose up -d --build`. Never commit the real .env file.

# --- Postgres ---
POSTGRES_USER=numberquest
POSTGRES_PASSWORD=change_me
POSTGRES_DB=numberquest

# --- App ---
# Port the app listens on inside the container / is published on the host.
PORT=3000
APP_PORT=3000

# Long random string used to sign session cookies. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET=change_me_to_a_long_random_string

NODE_ENV=production

# Set to the number of hops between the app and the public internet when
# running behind a reverse proxy (e.g. 1 for a single nginx/Caddy in front).
# Leave at 0 if the app is exposed directly.
TRUST_PROXY=0

# Set to true only once the app is served over HTTPS (directly or via a
# reverse proxy terminating TLS) - browsers drop "secure" cookies over plain
# HTTP, so leave this false for local/LAN testing.
COOKIE_SECURE=false

# --- Superadmin (optional) ---
# There is no public signup for this role. Set both to provision/update the
# one superadmin account (at /admin/login.html) who can view and manage
# every family, parent, and child on this instance. Leave blank to disable
# the feature. Changing ADMIN_PASSWORD and restarting rotates the password.
ADMIN_EMAIL=
ADMIN_PASSWORD=
